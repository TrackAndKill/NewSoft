[Unit]
Description=NewSoft nightly Postgres backup
Wants=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=newsoft-backup
Group=newsoft-backup
WorkingDirectory=/var/backups/newsoft
ExecStart=/opt/newsoft/infra/scripts/newsoft-backup.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/backups/newsoft /home/newsoft-backup
