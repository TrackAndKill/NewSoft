# Auto-TLS for firm.profithub.me. The auth hash is supplied via the
# NEWSOFT_BASIC_HASH env var (a bcrypt hash from `caddy hash-password`),
# loaded from /opt/newsoft/.env via a systemd drop-in for caddy.service.

firm.profithub.me {
    encode gzip

    basicauth * {
        founder {$NEWSOFT_BASIC_HASH}
    }

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
