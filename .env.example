# Copy to .env and fill in. .env is gitignored.

ANTHROPIC_API_KEY=***

# Postgres (used by docker-compose)
POSTGRES_USER=newsoft
POSTGRES_PASSWORD=***
POSTGRES_DB=newsoft
DATABASE_URL=postgresql+psycopg://newsoft:changeme@postgres:5432/newsoft

# Orchestrator
ORCHESTRATOR_PORT=8000
DRY_RUN=true
DAILY_SPEND_CAP_USD=20.00
MONEY_DAILY_CAP_USD=50.00
SYSTEM_ACTIVE=true
PUBLIC_DASHBOARD_URL=https://firm.profithub.me

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side dashboard calls should bypass public nginx Basic Auth.
INTERNAL_API_URL=http://127.0.0.1:8000

# Caddy basic auth compatibility (production uses nginx Basic Auth).
NEWSOFT_BASIC_HASH=$2a$14$replace_me_with_a_real_bcrypt_hash

# Phase 3 web search (optional; Scout falls back if unset)
WEB_SEARCH_PROVIDER=brave
BRAVE_API_KEY=***
BRAVE_SEARCH_API_KEY=***

# Phase 4 daily digest email (optional; unset writes digest_skipped event)
RESEND_API_KEY=***
DIGEST_TO_EMAIL=operator@example.com
DIGEST_FROM_EMAIL=founder@profithub.me
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=***
SMTP_USE_TLS=true

# Phase 4 Porkbun domain registration (optional; unset keeps registration dry-run/simulated)
PORKBUN_API_KEY=***
PORKBUN_API_SECRET=***

# Phase 5 site deployment / lead capture (optional; unset keeps deploy dry-run/manual)
VM_IPV4=
CERTBOT_EMAIL=
LEAD_IP_HASH_PEPPER=replace_with_random_string
