# Copy to .env and fill in. .env is gitignored.

ANTHROPIC_API_KEY=sk-ant-...

# Postgres (used by docker-compose)
POSTGRES_USER=newsoft
POSTGRES_PASSWORD=changeme
POSTGRES_DB=newsoft
DATABASE_URL=postgresql+psycopg://newsoft:changeme@postgres:5432/newsoft

# Orchestrator
ORCHESTRATOR_PORT=8000
DRY_RUN=true
DAILY_SPEND_CAP_USD=20.00
SYSTEM_ACTIVE=true

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000

# Caddy basic auth (production only).
# Generate with: caddy hash-password
# The username is "founder"; only the hash goes here.
NEWSOFT_BASIC_HASH=$2a$14$replace_me_with_a_real_bcrypt_hash

# Phase 3 web search (optional; Scout falls back if unset)
BRAVE_API_KEY=
WEB_SEARCH_PROVIDER=brave
